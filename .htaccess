# Apache — Cortec Middle East
Options -Indexes
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
RewriteEngine On
# force https + bare domain
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://cortec-me.com/$1 [L,R=301]
# legacy WordPress URLs
RewriteRule ^asset-integrity-assurance/?$ /solutions/ [L,R=301]
RewriteRule ^blogs/?$ /media/ [L,R=301]
RewriteRule ^brochures/?$ /media/ [L,R=301]
RewriteRule ^case-studies/?$ /projects/ [L,R=301]
RewriteRule ^client/?$ /projects/ [L,R=301]
RewriteRule ^contact-us/?$ /contact/ [L,R=301]
RewriteRule ^cortec-rd/?$ /about-us/ [L,R=301]
RewriteRule ^deira-waterfront-redevelopment/?$ /projects/ [L,R=301]
RewriteRule ^engineering-and-field-service/?$ /solutions/ [L,R=301]
RewriteRule ^home/?$ / [L,R=301]
RewriteRule ^join-our-teams/?$ /about-us/ [L,R=301]
RewriteRule ^news/?$ /media/ [L,R=301]
RewriteRule ^privacy-policy/?$ /privacy/ [L,R=301]
RewriteRule ^protection-of-aboveground-storage-tanks-2/?$ /protection-of-aboveground-storage-tanks/ [L,R=301]
RewriteRule ^request-a-webinar/?$ /solutions/ [L,R=301]
RewriteRule ^the-cortec-story/?$ /about-us/ [L,R=301]
RewriteRule ^the-cortec-story-2/?$ /about-us/ [L,R=301]
RewriteRule ^videos/?$ /media/ [L,R=301]
RewriteRule ^feed/?$ /media/ [L,R=301]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
<FilesMatch "\.(css|js|woff2|jpg|png|svg|mp4|webp)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.html$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
